PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chanda
# set to true for hosted DBs that need SSL (Neon, Supabase, Render...)
PGSSL=false
# the password you type on the login screen
ADMIN_PASSWORD=change-me
JWT_SECRET=put-a-long-random-string-here
# only needed if frontend is hosted on a different domain
CORS_ORIGIN=http://localhost:5173
